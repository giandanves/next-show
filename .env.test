# Environment variables declared in this file are ONLY AVAILABLE in your e2e and unit tests.
# See: https://github.com/blitz-js/next.js/issues/12287#issuecomment-933991952
#
# Prefer a dedicated Postgres database for tests (local or Neon branch).
# Prisma also needs DIRECT_URL (can match DATABASE_URL for local Postgres).

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/next-show_test?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/next-show_test?schema=public"
