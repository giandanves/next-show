# Copy to `.env` / `.env.local` for local development.
# On Vercel, set the same keys in Project → Settings → Environment Variables.

# Neon: use the *pooled* connection string for the app (host often contains `-pooler`).
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&pgbouncer=true"

# Neon: use the *direct* (non-pooled) connection string for migrations.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# Required in production (min 32 chars). Generate with: openssl rand -hex 32
SESSION_SECRET_KEY="replace-with-a-long-random-secret-at-least-32-chars"

# Public site origin. On Vercel: https://your-app.vercel.app
APP_ORIGIN="http://localhost:3000"
